{
  "name": "@telegraphprotocol/telegraph-protocol-mcp",
  "version": "2.0.0",
  "description": "MCP server for the Telegraph network: ask ranked miners (prices, FX, weather, search, security, code review and 100+ intents), browse intents, miners and rankings, and pay from escrow or by x402 in USDC",
  "mcpName": "io.github.telegraphprotocol/telegraph",
  "main": "dist/index.js",
  "bin": {
    "telegraph-protocol-mcp": "dist/index.js"
  },
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/telegraphprotocol/telegraph-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/telegraphprotocol/telegraph-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/telegraphprotocol/telegraph-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "telegraph",
    "ai-agents",
    "x402",
    "escrow",
    "usdc",
    "agent-payments",
    "miners",
    "ranking",
    "web3"
  ],
  "files": [
    "dist",
    "guides",
    "README.md",
    ".agents"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector dist/index.js",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@x402/fetch": "^2.11.0",
    "@x402/evm": "^2.11.0",
    "@x402/core": "^2.11.0",
    "viem": "^2.21.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0"
  }
}

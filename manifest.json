{
  "manifest_version": "0.3",
  "name": "telegraph",
  "display_name": "Telegraph",
  "version": "2.3.0",
  "description": "Ask Telegraph's ranked miners for prices, FX, weather, search and specialist answers, paid from your Anjoman account through an API key.",
  "author": {
    "name": "Telegraph Protocol",
    "url": "https://telegraphprotocol.com"
  },
  "homepage": "https://anjoman.ai/dashboard/integrations",
  "documentation": "https://anjoman.ai/docs/using/mcp-server",
  "repository": {
    "type": "git",
    "url": "https://github.com/telegraphprotocol/telegraph-mcp"
  },
  "license": "MIT",
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/dist/index.js"],
      "env": {
        "TELEGRAPH_API_KEY": "${user_config.api_key}"
      }
    }
  },
  "user_config": {
    "api_key": {
      "type": "string",
      "title": "Anjoman API key",
      "description": "Starts with anjoman_. Create one at https://anjoman.ai/dashboard/api-keys. Questions are paid from your Anjoman balance.",
      "sensitive": true,
      "required": true
    }
  },
  "tools_generated": true,
  "compatibility": {
    "platforms": ["darwin", "win32"],
    "runtimes": {
      "node": ">=20.0.0"
    }
  }
}

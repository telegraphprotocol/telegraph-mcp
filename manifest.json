{
  "manifest_version": "0.3",
  "name": "telegraph",
  "display_name": "Telegraph",
  "version": "2.0.0",
  "description": "Ask Telegraph's ranked miners for prices, FX, weather, search and specialist answers, paid from your Telegraph escrow.",
  "author": {
    "name": "Telegraph Protocol",
    "url": "https://telegraphprotocol.com"
  },
  "homepage": "https://anjoman.ai/dashboard/integrations",
  "documentation": "https://anjoman.ai/docs/using/mcp-server",
  "repository": {
    "type": "git",
    "url": "https://github.com/telegraphprotocol/telegraph-mcp"
  },
  "license": "MIT",
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/dist/index.js"]
    }
  },
  "tools_generated": true,
  "compatibility": {
    "platforms": ["darwin", "win32"],
    "runtimes": {
      "node": ">=20.0.0"
    }
  }
}

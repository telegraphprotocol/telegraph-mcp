# For `npm start` / start-mcp.sh. Normally nothing is needed: `npx -y @telegraphprotocol/telegraph-protocol-mcp setup`
# saves a wallet to ~/.telegraph/wallet.json and the server uses it.

# Optional: a key instead of the wallet file (servers, CI).
# TELEGRAPH_PRIVATE_KEY=0x_your_private_key_here

# Optional
# TELEGRAPH_PAYMENT=escrow           # escrow (default) | auto (escrow, then x402) | x402
# TELEGRAPH_MAX_ASK_USD=0.5
# TELEGRAPH_DAILY_LIMIT_USD=5
# TELEGRAPH_URL=https://devnode.telegraphprotocol.com
# TELEGRAPH_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
